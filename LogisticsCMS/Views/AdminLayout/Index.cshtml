<!DOCTYPE html>
<html lang="tr">
<head>
    @await Component.InvokeAsync("AdminLayoutHead")
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/admin-design-system.css" asp-append-version="true" />
</head>

<body data-menu-color="light" data-sidebar="default">
    <div id="app-layout">
        @await Component.InvokeAsync("AdminLayoutTopBar")
        @await Component.InvokeAsync("AdminLayoutSideBar")

        <div class="content-page">
            <div class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    @await Component.InvokeAsync("AdminLayoutScripts")
    @RenderSection("Scripts", required: false)
</body>
</html>
